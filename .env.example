# ==============================================================================
# NANDINHA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: All variables prefixed with VITE_ are injected into the client-side bundle
# and are publicly readable. NEVER STORE SECRET KEYS OR SENSITIVE DATA HERE.
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Optional Feature Toggles
VITE_ENABLE_PERF_MONITOR=false
VITE_ENABLE_LOW_POWER_OVERRIDE=false
